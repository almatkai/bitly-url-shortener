{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "bitly-url-shortener",
  "title": "Bitly URL Shortener",
  "description": "Quickly shorten the selected URL or current clipboard URL with Bitly",
  "icon": "command-icon.png",
  "categories": [
    "Communication"
  ],
  "author": "almatkai",
  "contributors": [
    "xmok",
    "0xdhrv"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Shorten URL",
      "subtitle": "Bitly",
      "description": "Overwrite the clipboard contents with a shortened URL",
      "mode": "no-view",
      "platforms": [
        "macOS",
        "Windows"
      ]
    },
    {
      "name": "list-links",
      "title": "List Links",
      "subtitle": "Bitly",
      "description": "List all the links you have shortened with Bitly",
      "mode": "view",
      "preferences": [
        {
          "name": "group_guid",
          "type": "textfield",
          "required": true,
          "title": "Group GUID",
          "description": "Your Bitly group GUID",
          "placeholder": "Oa1bcd234eF"
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "preferences": [
    {
      "name": "accessToken",
      "type": "password",
      "required": true,
      "title": "Access Token",
      "description": "Your Bitly access token.",
      "placeholder": "Can be found at https://app.bitly.com/settings/api"
    },
    {
      "name": "pasteAfterShortening",
      "type": "checkbox",
      "required": false,
      "default": false,
      "label": "Automatically paste shortened URL",
      "description": "Automatically paste the shortened URL after shortening it."
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "@raycast/utils": "^2.2.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "tsx": "^4.22.4"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "platforms": [
    "macOS",
    "Windows"
  ],
  "id": "com.tezbar.bitly-url-shortener",
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/bitly-url-shortener",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/bitly-url-shortener",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
