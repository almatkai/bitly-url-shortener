# Inactive review definition: intentionally NOT under .github/workflows.
name: external-bitly-v2
on: [workflow_dispatch]
jobs:
  rust:
    strategy:
      matrix:
        os: [macos-14, windows-latest]
        toolchain: [stable, '1.85.0']
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@master
        with:
          toolchain: ${{ matrix.toolchain }}
          components: rustfmt, clippy
      - run: cargo fmt --manifest-path v2/Cargo.toml --check
      - run: cargo test --locked --manifest-path v2/Cargo.toml --all-targets --features qa
      - run: cargo clippy --locked --manifest-path v2/Cargo.toml --all-targets --features qa -- -D warnings
      - run: cargo build --locked --manifest-path v2/Cargo.toml --release --bin bitly-url-shortener
# No publishing, installation or real Bitly/desktop traffic. Before activation, pin action SHAs,
# add native Windows OS-pipe QA, and review tests/tooling licensing separately.
